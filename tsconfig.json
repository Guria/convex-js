{
  "include": ["src"],
  "compilerOptions": {
    "target": "es2022",
    "module": "es2020",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  }
}
